# {{HEADER_COMMENT}}
# Generated by gen-upgrade-config skill on {{GENERATED_AT}}
# Run: ./upgrade --config {{SELF_PATH}}
# Credentials: export VIOLET_PLATFORM_USERNAME / VIOLET_PLATFORM_PASSWORD (see ../../SKILL.md)

immediate: {{IMMEDIATE}}
logLevel: {{LOG_LEVEL}}

operatorConfig:
  type: operatorhub
  name: {{OPERATOR_NAME}}
  namespace: {{OPERATOR_NAMESPACE}}
  workspace: {{WORKSPACE}}
  # artifact: {{ARTIFACT_OVERRIDE}}   # 留空则自动拼成 operatorhub-{{OPERATOR_NAME}}
  timeout: {{TIMEOUT}}
  interval: {{INTERVAL}}

  violet:
    packagePrefix: {{PACKAGE_PREFIX}}
    platformAddress: {{PLATFORM_ADDRESS}}
    clusters: {{CLUSTERS}}
    # 凭证：默认走环境变量 VIOLET_PLATFORM_USERNAME / VIOLET_PLATFORM_PASSWORD
    # 仅在本地一次性调试时取消下面两行注释（注意：会进 git）
    # platformUsername: {{PLATFORM_USERNAME}}
    # platformPassword: {{PLATFORM_PASSWORD}}
    localPackageDir: {{LOCAL_PACKAGE_DIR}}
    # skipPush 默认 true；私有 registry 场景置 false 并补 pushArgs
    # skipPush: false
    # pushArgs:
    #   - --dest-repo
    #   - {{DEST_REPO}}
    #   - --plain
    #   - --image-pull-secret
    #   - {{IMAGE_PULL_SECRET}}

upgradePaths:
  - name: {{PATH_NAME}}
    versions:
{{VERSIONS_BLOCK}}
